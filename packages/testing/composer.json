{
    "name": "indexnowkit/testing",
    "description": "Test kit for indexnowkit: the conformance suites every adapter runs (C01-C22, A01-A21), the assertions for key file and check-command tests (H01-H05), README assertions, and the mock IndexNow server",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "testing",
        "phpunit",
        "conformance",
        "seo"
    ],
    "homepage": "https://indexnowkit.github.io/php/testing/",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-testing",
        "docs": "https://github.com/indexnowkit/php-testing/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-testing/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "indexnowkit/core": "^0.9"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "phpunit/phpunit": "The conformance test cases extend PHPUnit\\Framework\\TestCase and the assertions call PHPUnit\\Framework\\Assert (^11)"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\Testing\\Conformance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\Testing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
