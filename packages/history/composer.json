{
    "name": "indexnowkit/history",
    "description": "Submission history for indexnowkit: PSR-16 and PDO implementations of SubmissionStoreInterface, the history and status commands, the profiler tab",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "indexnow",
        "seo",
        "history",
        "audit",
        "yandex",
        "bing",
        "indexing"
    ],
    "homepage": "https://indexnowkit.github.io/php/history/",
    "authors": [
        {
            "name": "Igor Pinchuk",
            "email": "i.pinchuk.work@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/indexnowkit/php/issues",
        "source": "https://github.com/indexnowkit/php-history",
        "docs": "https://github.com/indexnowkit/php-history/blob/main/README.md",
        "security": "https://github.com/indexnowkit/php-history/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "indexnowkit/core": "^0.13",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "indexnowkit/console": "^0.5",
        "indexnowkit/testing": "^0.3",
        "justinrainbow/json-schema": "^6.0",
        "phpstan/phpstan": "^2.2.13",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "roave/security-advisories": "dev-latest",
        "symfony/console": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "indexnowkit/console": "The history and status commands (^0.5, with symfony/console)",
        "ext-pdo": "The PDO store (history.store: pdo)"
    },
    "autoload": {
        "psr-4": {
            "IndexNowKit\\History\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\History\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "ci:install:highest": "@composer update --no-interaction --prefer-dist",
        "ci:install:lowest": "@composer update --no-interaction --prefer-dist --prefer-lowest --prefer-stable"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    }
}
