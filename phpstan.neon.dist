includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/larastan/larastan/extension.neon
parameters:
    level: 9
    paths:
        - packages/core/src
        - packages/doctrine/src
        - packages/symfony-bundle/src
        - packages/laravel/src
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # larastan resolves facade roots through @mixin, which makes phpstan-strict-rules see their methods as static
        - identifier: staticMethod.dynamicCall
          path: packages/laravel/src/*
        # used by application models, not by the package itself
        - identifier: trait.unused
          path: packages/laravel/src/Eloquent/IndexNowable.php
    excludePaths:
        # DBAL 3 flavour (bool return types) cannot be analysed against DBAL 4 signatures; covered by the DBAL 3 CI job
        - packages/doctrine/src/Middleware/IndexNowConnectionV3.php
