{
    "name": "indexnowkit/php-monorepo",
    "description": "Development monorepo for indexnowkit PHP packages (core, doctrine, symfony-bundle, laravel, yii2)",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "indexnowkit/core": "@dev",
        "indexnowkit/doctrine": "@dev",
        "indexnowkit/symfony-bundle": "@dev",
        "indexnowkit/laravel": "@dev",
        "indexnowkit/yii2": "@dev"
    },
    "require-dev": {
        "doctrine/dbal": "^3.8 || ^4.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^2.19 || ^3.0",
        "doctrine/persistence": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "larastan/larastan": "^3.0",
        "nyholm/psr7": "^1.8",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "psr/clock": "^1.0",
        "symfony/browser-kit": "^6.4 || ^7.0",
        "symfony/cache": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/messenger": "^6.4 || ^7.0",
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0",
        "yidas/yii2-composer-bower-skip": "^2.0",
        "yiisoft/yii2": "^2.0.45",
        "yiisoft/yii2-queue": "^2.3"
    },
    "autoload-dev": {
        "psr-4": {
            "IndexNowKit\\Tests\\": "packages/core/tests/",
            "IndexNowKit\\Doctrine\\Tests\\": "packages/doctrine/tests/",
            "IndexNowKit\\SymfonyBundle\\Tests\\": "packages/symfony-bundle/tests/",
            "IndexNowKit\\Laravel\\Tests\\": "packages/laravel/tests/",
            "IndexNowKit\\Yii2\\Tests\\": "packages/yii2/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
