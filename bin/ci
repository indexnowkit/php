#!/usr/bin/env bash
# Run a package's pipeline the way .github/workflows/ci.yml does, in Docker:
# link the siblings, install a dependency flavour, phpunit, phpstan.
# Usage: bin/ci [package] [flavour]   default: every package, highest.
#   bin/ci yii2                 bin/ci doctrine dbal3                 PHP_VERSION=8.2 bin/ci core lowest
# Flavours are the ci:install:* scripts of the package's composer.json.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
flavour="${2:-highest}"
if [ -n "${1:-}" ]; then packages=("$1"); else packages=(); for d in packages/*/; do packages+=("$(basename "$d")"); done; fi
for pkg in "${packages[@]}"; do
    echo "::group::${pkg} / PHP ${PHP_VERSION:-8.3} / ${flavour}"
    bin/link "$pkg"
    COMPOSER=composer.monorepo.json bin/composer -d "packages/$pkg" run "ci:install:$flavour"
    bin/php -C "packages/$pkg" vendor/bin/phpunit
    if [ "$flavour" = dbal3 ]; then   # doctrine: the DBAL 3 connection instead of the DBAL 4 one
        bin/php -C "packages/$pkg" vendor/bin/phpstan analyse --memory-limit=1G -c phpstan.dbal3.neon
    else
        bin/php -C "packages/$pkg" vendor/bin/phpstan analyse --memory-limit=1G
    fi
    echo "::endgroup::"
done
