#!/usr/bin/env bash
# Release a package: push the php/ subtree to indexnowkit/php and tag <package>@<version> on the subtree sha there.
# The split workflow (.github/workflows/split.yml) then mirrors the package into indexnowkit/php-<package> and pushes
# the tag <version> to it, which Packagist picks up through its webhook.
#
# Usage: bin/tag <package> <version>          bin/tag core 0.4.0
# Refuses a dirty working tree, a version missing from the package CHANGELOG, or a tag that already exists.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="git@github.com:indexnowkit/php.git"
pkg="${1:?usage: bin/tag <package> <version>}"
ver="${2:?usage: bin/tag <package> <version>}"
tag="${pkg}@${ver}"
cd "$ROOT/.."
[ -d "php/packages/$pkg" ] || { echo "tag: no package php/packages/$pkg" >&2; exit 1; }
[[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "tag: version must be x.y.z, got $ver" >&2; exit 1; }
if [ -n "$(git status --porcelain)" ]; then
    echo "tag: the working tree is dirty; commit first" >&2
    exit 1
fi
grep -Eq "^## \[?${ver//./\\.}\]? — [0-9]{4}-[0-9]{2}-[0-9]{2}" "php/packages/$pkg/CHANGELOG.md" || { echo "tag: php/packages/$pkg/CHANGELOG.md has no section '## [$ver] — YYYY-MM-DD'" >&2; exit 1; }
if git ls-remote --tags "$REPO" "refs/tags/$tag" | grep -q .; then
    echo "tag: $tag already exists on $REPO" >&2
    exit 1
fi
sha="$(git subtree split --prefix=php -q)"
git push -q "$REPO" "${sha}:refs/heads/main"
git push -q "$REPO" "${sha}:refs/tags/${tag}"
echo "tagged $tag on ${sha:0:7} (indexnowkit/php); split.yml pushes $ver to indexnowkit/php-$pkg"
