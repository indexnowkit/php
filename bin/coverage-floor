#!/usr/bin/env bash
# Compare the line coverage of a package (a clover report) with the floor recorded in
# packages/<package>/tests/coverage-floor.txt; below the floor is a failure. The floor is the coverage measured when
# it was set (spec 16 §5): raising it is a normal commit, lowering it is a separate commit with the reason.
#
# Usage: bin/coverage-floor <package> <clover.xml>            compare, exit 1 below the floor
#        bin/coverage-floor <package> <clover.xml> --write    record the current coverage as the floor
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
pkg="${1:?usage: bin/coverage-floor <package> <clover.xml> [--write]}"
clover="${2:?usage: bin/coverage-floor <package> <clover.xml> [--write]}"
mode="${3:-}"
floor_file="$ROOT/packages/$pkg/tests/coverage-floor.txt"
[ -f "$clover" ] || { echo "coverage-floor: no clover report at $clover" >&2; exit 1; }
# the last <metrics> element of a clover file is the project total
read -r statements covered < <(grep -o '<metrics [^>]*>' "$clover" | tail -1 | sed -E 's/.* statements="([0-9]+)".* coveredstatements="([0-9]+)".*/\1 \2/')
[ "${statements:-0}" -gt 0 ] || { echo "coverage-floor: no statements in $clover" >&2; exit 1; }
current="$(awk -v c="$covered" -v s="$statements" 'BEGIN { printf "%.2f", 100 * c / s }')"
if [ "$mode" = "--write" ]; then
    printf '%s\n' "$current" > "$floor_file"
    echo "coverage-floor: $pkg floor set to ${current}% ($covered/$statements statements) in packages/$pkg/tests/coverage-floor.txt"
    exit 0
fi
[ -f "$floor_file" ] || { echo "coverage-floor: no floor recorded for $pkg; run with --write first" >&2; exit 1; }
floor="$(tr -d '[:space:]' < "$floor_file")"
if awk -v c="$current" -v f="$floor" 'BEGIN { exit !(c + 0 < f + 0) }'; then
    echo "coverage-floor: $pkg line coverage ${current}% is below the floor ${floor}% ($covered/$statements statements)" >&2
    exit 1
fi
echo "coverage-floor: $pkg line coverage ${current}% (floor ${floor}%, $covered/$statements statements)"
