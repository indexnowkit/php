#!/usr/bin/env bash
# Poll Packagist until indexnowkit/<package> lists <version>: the adapters of a release wave are tagged only once the
# core (or sitemap) version they require is installable from Packagist, otherwise their split CI resolves dev-main.
#
# Usage: bin/packagist-wait <package> <version> [max_seconds]     bin/packagist-wait core 0.4.0
# Exit 0 when the version is visible, 1 after max_seconds (default 900). Polls every 30 s.
set -euo pipefail
pkg="${1:?usage: bin/packagist-wait <package> <version> [max_seconds]}"
ver="${2:?usage: bin/packagist-wait <package> <version> [max_seconds]}"
max="${3:-900}"
url="https://repo.packagist.org/p2/indexnowkit/${pkg}.json"
t=0
while :; do
    if curl -fsS "$url" | grep -Eq "\"version\": ?\"${ver//./\\.}\""; then
        echo "packagist: indexnowkit/$pkg $ver available after ${t}s"
        exit 0
    fi
    if [ "$t" -ge "$max" ]; then
        echo "packagist: indexnowkit/$pkg $ver NOT visible after ${max}s ($url)" >&2
        exit 1
    fi
    sleep 30
    t=$((t + 30))
done
