#!/usr/bin/env bash
# Write packages/<name>/composer.monorepo.json for the given packages (default: all): the package manifest plus
# path repositories for every sibling package, so `composer update` resolves the working copy of indexnowkit/*
# instead of the Packagist release. Run Composer with COMPOSER=composer.monorepo.json afterwards.
# Runs on the local php when there is one (CI), otherwise in the development image.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v php >/dev/null 2>&1; then
    exec php "$ROOT/bin/link.php" "$@"
fi
exec "$ROOT/bin/php" bin/link.php "$@"
