#!/usr/bin/env python3
"""Collect the READMEs and docs of the packages into docs-site/docs/ for MkDocs, rewriting links so the site is
self-contained, and generate mkdocs.yml (nav) plus llms.txt / llms-full.txt.

Layout of the site (spec 17 §3.2): getting started per framework (the READMEs), then the core reference pages,
then each package's docs. Every package README becomes <pkg>/index.md; every docs/<f>.md becomes <pkg>/<f>.md.
Links: `](docs/x.md)` -> `](x.md)`; absolute GitHub links into packages/<pkg>/(docs/)<f>.md -> site-relative;
`tree/main/packages/<pkg>` -> the package index; the `php-<pkg>` split repositories likewise.

Usage: bin/docs-collect            (writes docs-site/docs, docs-site/mkdocs.yml)
"""
import os
import re
import shutil
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SITE = os.path.join(ROOT, 'docs-site')
OUT = os.path.join(SITE, 'docs')
BASE_URL = 'https://indexnowkit.github.io/php/'
PACKAGES = ['core', 'sitemap', 'doctrine', 'symfony-bundle', 'laravel', 'yii2']
TITLES = {'core': 'Core (plain PHP)', 'sitemap': 'Sitemap', 'doctrine': 'Doctrine', 'symfony-bundle': 'Symfony', 'laravel': 'Laravel', 'yii2': 'Yii2'}

# Section -> list of (title, "pkg/file.md") shown in the nav in this order; the rest of a package's docs follow under Packages.
GETTING_STARTED = [('Symfony', 'symfony-bundle/index.md'), ('Laravel', 'laravel/index.md'), ('Yii2', 'yii2/index.md'), ('Plain PHP', 'core/index.md')]
REFERENCE = [
    ('Attribute reference', 'core/attribute-reference.md'),
    ('Configuration', 'core/configuration.md'),
    ('Operations', 'core/operations.md'),
    ('Retries and queues', 'core/retries-and-queues.md'),
    ('Testing', 'core/testing.md'),
    ('Writing an adapter', 'core/adapters.md'),
    ('Compatibility (core)', 'core/bc.md'),
]


def title_of(path):
    with open(path, encoding='utf-8') as f:
        for line in f:
            if line.startswith('# '):
                return line[2:].strip().replace('`', '')
    return os.path.basename(path)


def rewrite(text, pkg, in_docs):
    """Rewrite links of a page of <pkg> (in_docs: the page lives in docs/, i.e. next to its siblings)."""
    def pkg_link(m):
        target, file = m.group(1), m.group(2)
        return '](%s/%s)' % ('../' + target if target != pkg else '.', file)

    # absolute links into the monorepo
    text = re.sub(r'\]\(https://github\.com/indexnowkit/php/blob/main/packages/([a-z0-9-]+)/docs/([A-Za-z0-9._-]+\.md)(#[^)]*)?\)',
                  lambda m: '](%s/%s%s)' % ('../' + m.group(1) if m.group(1) != pkg else '.', m.group(2), m.group(3) or ''), text)
    text = re.sub(r'\]\(https://github\.com/indexnowkit/php/blob/main/packages/([a-z0-9-]+)/README\.md(#[^)]*)?\)',
                  lambda m: '](%s/index.md%s)' % ('../' + m.group(1) if m.group(1) != pkg else '.', m.group(2) or ''), text)
    text = re.sub(r'\]\(https://github\.com/indexnowkit/php/tree/main/packages/([a-z0-9-]+)/?\)',
                  lambda m: '](%s/index.md)' % ('../' + m.group(1) if m.group(1) != pkg else '.'), text)
    # links into the split repositories
    text = re.sub(r'\]\(https://github\.com/indexnowkit/php-([a-z0-9-]+)/blob/main/docs/([A-Za-z0-9._-]+\.md)(#[^)]*)?\)',
                  lambda m: '](%s/%s%s)' % ('../' + m.group(1) if m.group(1) != pkg else '.', m.group(2), m.group(3) or ''), text)
    # relative links inside the package
    if in_docs:
        text = re.sub(r'\]\(\.\./README\.md(#[^)]*)?\)', lambda m: '](index.md%s)' % (m.group(1) or ''), text)
        text = re.sub(r'\]\(\.\./CHANGELOG\.md\)', '](https://github.com/indexnowkit/php/blob/main/packages/%s/CHANGELOG.md)' % pkg, text)
    else:
        text = re.sub(r'\]\(docs/([A-Za-z0-9._-]+\.md)(#[^)]*)?\)', lambda m: '](%s%s)' % (m.group(1), m.group(2) or ''), text)
        for f in ['CHANGELOG.md', 'CONTRIBUTING.md', 'SECURITY.md', 'LICENSE', 'README.ru.md']:
            text = text.replace('](%s)' % f, '](https://github.com/indexnowkit/php/blob/main/packages/%s/%s)' % (pkg, f))
        text = re.sub(r'\]\(config/([A-Za-z0-9._/-]+)\)', lambda m: '](https://github.com/indexnowkit/php/blob/main/packages/%s/config/%s)' % (pkg, m.group(1)), text)
    # HTML comments used by tests are noise on the site
    text = re.sub(r'<!-- /?test[^>]*-->\n?', '', text)
    text = re.sub(r'<!-- /?config-table:[a-z]+ -->\n?', '', text)
    return text


def main():
    if os.path.isdir(OUT):
        shutil.rmtree(OUT)
    os.makedirs(OUT)
    pages = {}   # "pkg/file.md" -> title
    package_docs = {p: [] for p in PACKAGES}
    for pkg in PACKAGES:
        src = os.path.join(ROOT, 'packages', pkg)
        os.makedirs(os.path.join(OUT, pkg))
        readme = os.path.join(src, 'README.md')
        with open(readme, encoding='utf-8') as f:
            text = rewrite(f.read(), pkg, False)
        with open(os.path.join(OUT, pkg, 'index.md'), 'w', encoding='utf-8') as f:
            f.write(text)
        pages['%s/index.md' % pkg] = title_of(readme)
        docs = os.path.join(src, 'docs')
        if os.path.isdir(docs):
            for name in sorted(os.listdir(docs)):
                if not name.endswith('.md'):
                    continue
                with open(os.path.join(docs, name), encoding='utf-8') as f:
                    text = rewrite(f.read(), pkg, True)
                with open(os.path.join(OUT, pkg, name), 'w', encoding='utf-8') as f:
                    f.write(text)
                key = '%s/%s' % (pkg, name)
                pages[key] = title_of(os.path.join(docs, name))
                if not name.endswith('.ru.md'):   # translations are pages, not nav entries
                    package_docs[pkg].append(key)

    # front page
    with open(os.path.join(OUT, 'index.md'), 'w', encoding='utf-8') as f:
        f.write(FRONT)
    pages['index.md'] = 'indexnowkit for PHP'

    # nav
    nav = ["  - Home: index.md", "  - Getting started:"]
    nav += ["    - %s: %s" % (t, p) for t, p in GETTING_STARTED]
    nav += ["  - Reference:"] + ["    - %s: %s" % (t, p) for t, p in REFERENCE]
    nav += ["  - Packages:"]
    for pkg in PACKAGES:
        nav.append("    - %s:" % TITLES[pkg])
        nav.append("      - Overview: %s/index.md" % pkg)
        for key in package_docs[pkg]:
            if key in dict(REFERENCE).values():
                continue
            nav.append("      - %s: %s" % (pages[key].replace(':', ' -'), key))
    with open(os.path.join(SITE, 'mkdocs.template.yml'), encoding='utf-8') as f:
        template = f.read()
    with open(os.path.join(SITE, 'mkdocs.yml'), 'w', encoding='utf-8') as f:
        f.write(template.replace('#NAV#', "\n".join(nav)))

    # llms.txt (index) and llms-full.txt (everything)
    order = ['index.md'] + [p for _, p in GETTING_STARTED] + [p for _, p in REFERENCE]
    order += [k for pkg in PACKAGES for k in ['%s/index.md' % pkg] + package_docs[pkg] if k not in order]
    order += sorted(k for k in pages if k.endswith('.ru.md'))
    with open(os.path.join(OUT, 'llms.txt'), 'w', encoding='utf-8') as f:
        f.write("# indexnowkit for PHP\n\n> IndexNow for PHP: a framework-agnostic core plus Symfony, Laravel, Yii2 and Doctrine adapters. Declare public pages on the model with #[IndexNow]; submissions leave after the transaction commits, debounced and batched.\n\n")
        f.write("Packagist: indexnowkit/core, indexnowkit/sitemap, indexnowkit/doctrine, indexnowkit/symfony-bundle, indexnowkit/laravel, indexnowkit/yii2. Source and issues: https://github.com/indexnowkit/php\n\n## Pages\n\n")
        for key in order:
            f.write("- [%s](%s%s)\n" % (pages[key], BASE_URL, key[:-3] + '/' if key != 'index.md' else ''))
        f.write("\n## Full text\n\n- [llms-full.txt](%sllms-full.txt)\n" % BASE_URL)
    with open(os.path.join(OUT, 'llms-full.txt'), 'w', encoding='utf-8') as f:
        for key in order:
            with open(os.path.join(OUT, key), encoding='utf-8') as page:
                f.write("<!-- %s%s -->\n" % (BASE_URL, key[:-3] + '/' if key != 'index.md' else ''))
                f.write(page.read().rstrip("\n") + "\n\n")
    print("docs-collect: %d pages -> %s" % (len(pages), OUT))


FRONT = """# indexnowkit for PHP

Tell search engines (Bing, Yandex, Naver, Seznam, Yep, and the other participants of the IndexNow registry) about
new, changed and deleted pages the moment a model is committed. One attribute on the model, one key, done.
Google does not participate; IndexNow is a notification, not indexing.

| Package | Framework | Install |
|---|---|---|
| [Symfony bundle](symfony-bundle/index.md) | Symfony 6.4 \\| 7 \\| 8 + Doctrine | `composer require indexnowkit/symfony-bundle indexnowkit/doctrine` |
| [Laravel](laravel/index.md) | Laravel 12 \\| 13 | `composer require indexnowkit/laravel` |
| [Yii2](yii2/index.md) | Yii 2.0.45+ | `composer require indexnowkit/yii2` |
| [Doctrine](doctrine/index.md) | Doctrine ORM without Symfony | `composer require indexnowkit/doctrine` |
| [Core](core/index.md) | plain PHP, any PSR-18 client | `composer require indexnowkit/core` |
| [Sitemap](sitemap/index.md) | the `sitemap` command of every adapter | `composer require indexnowkit/sitemap` |

Start with the page of your framework, then the [attribute reference](core/attribute-reference.md), the
[configuration](core/configuration.md) (one table for the three adapters) and the [operations guide](core/operations.md)
with its production checklist. Machine-readable: [llms.txt](llms.txt), [llms-full.txt](llms-full.txt).
Issues and pull requests: [github.com/indexnowkit/php](https://github.com/indexnowkit/php).
"""

if __name__ == '__main__':
    sys.exit(main())
