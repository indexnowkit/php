#!/usr/bin/env bash
# Run PHP CLI inside Docker (no local PHP).
# Usage: bin/php [-v 8.2] [-C packages/yii2] <args>   PHP_VERSION sets the default version (8.3).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VER="${PHP_VERSION:-8.3}"
DIR="."
while :; do
    case "${1:-}" in
        -v) VER="$2"; shift 2 ;;
        -C) DIR="$2"; shift 2 ;;
        *) break ;;
    esac
done
tty=(); [ -t 1 ] && tty=(-t)
exec docker run --rm ${tty[@]+"${tty[@]}"} -v "$ROOT:/app" -w "/app/$DIR" "php:${VER}-cli" php "$@"
